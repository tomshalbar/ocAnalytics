# Deployed Render backend (no local Uvicorn server needed).
EXPO_PUBLIC_API_URL=https://open-court-analytics-api.onrender.com

# Local development alternatives:
# Physical phone: use your computer's LAN IP (same Wi-Fi).
# Android emulator: http://10.0.2.2:8000
# iOS simulator: http://127.0.0.1:8000

# Optional: allow Render free-tier cold starts (default 15000).
# Valid range: 1000–300000 whole milliseconds.
EXPO_PUBLIC_API_TIMEOUT_MS=90000
